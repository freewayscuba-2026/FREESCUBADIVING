{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.freewayscubadiving.com"
        }
      ],
      "headers": {
        "Location": "https://freewayscubadiving.com/$1"
      },
      "status": 308
    },
    {
      "src": "^/es/cenote-diving/?$",
      "headers": {
        "Location": "/es/buceo-en-cenotes"
      },
      "status": 308
    },
    {
      "src": "^/es/reef-diving/?$",
      "headers": {
        "Location": "/es/buceo-en-arrecifes"
      },
      "status": 308
    },
    {
      "src": "^/es/diving-courses/?$",
      "headers": {
        "Location": "/es/cursos-de-buceo"
      },
      "status": 308
    },
    {
      "src": "^/es/packages/?$",
      "headers": {
        "Location": "/es/paquetes-y-tours"
      },
      "status": 308
    },
    {
      "src": "^/es/about/?$",
      "headers": {
        "Location": "/es/nosotros"
      },
      "status": 308
    },
    {
      "src": "^/es/faq/?$",
      "headers": {
        "Location": "/es/preguntas-frecuentes"
      },
      "status": 308
    },
    {
      "src": "^/es/contact/?$",
      "headers": {
        "Location": "/es/contacto"
      },
      "status": 308
    },
    {
      "src": "^/es/book/?$",
      "headers": {
        "Location": "/es/reservar"
      },
      "status": 308
    },
    {
      "src": "^/home(?:/.*)?$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/(?:fr|de|ru|it|pt|nl|pl)(?:/.*)?$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/whale-shark/?$",
      "headers": {
        "Location": "/reef-diving"
      },
      "status": 308
    },
    {
      "src": "^/(.+)/$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.+)$",
      "dest": "/$1/index.html",
      "check": true
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
